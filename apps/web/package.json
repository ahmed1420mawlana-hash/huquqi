{
  "name": "@huquqi/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma db execute --file prisma/pre-push.sql --schema prisma/schema.prisma && prisma db push --skip-generate && next build"
  },
  "dependencies": {
    "@huquqi/core": "*",
    "@prisma/client": "6.19.3",
    "@vercel/blob": "^2.9.0",
    "jose": "6.2.18",
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.9",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
