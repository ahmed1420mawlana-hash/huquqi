# PostgreSQL connection string (Neon: use the direct, non-pooled string)
DATABASE_URL="postgresql://postgres@localhost:5432/huquqi"
# 32+ random characters, used to sign session cookies
SESSION_SECRET="change-me-to-a-long-random-string-0123456789"
# Show one-time login codes on screen as well as emailing them.
# Works in development, and in production only while DEMO_PASSWORD protects the site.
DEV_SHOW_OTP="1"
# When set, the whole site asks for this password first (demo deployments)
DEMO_PASSWORD=""
# Email addresses (comma separated) that become ADMIN on first login
ADMIN_EMAILS="admin@huquqi.test"
# Admins can also log in with their mobile number ("Admin login" link on the login page).
# Only numbers listed here can use phone login. There is no SMS gateway yet, so the code is
# shown on screen (development, or a demo behind DEMO_PASSWORD).
ADMIN_PHONES="+8801700000000"
# WhatsApp number shown to clients after they submit (defaults to first ADMIN_PHONES)
WHATSAPP_NUMBER=
# Login codes are emailed through Resend (resend.com). Without a key, codes are only shown
# on screen (development, or a demo behind DEMO_PASSWORD).
# RESEND_API_KEY=""
# EMAIL_FROM="Huquqi <login@your-domain.com>"
# Document storage: when BLOB_READ_WRITE_TOKEN is set (Vercel Blob), the browser uploads files
# straight to private blobs (up to 500 MB each, about 1,000 scanned pages); otherwise files go
# through the server to local disk in UPLOAD_DIR (up to 200 MB each).
UPLOAD_DIR="./uploads"
# BLOB_READ_WRITE_TOKEN=""
