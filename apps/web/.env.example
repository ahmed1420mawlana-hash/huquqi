# PostgreSQL connection string (Neon: use the direct, non-pooled string)
DATABASE_URL="postgresql://postgres@localhost:5432/huquqi"
# 32+ random characters, used to sign session cookies
SESSION_SECRET="change-me-to-a-long-random-string-0123456789"
# Show one-time login codes on screen instead of sending SMS.
# Works in development, and in production only while DEMO_PASSWORD protects the site.
DEV_SHOW_OTP="1"
# When set, the whole site asks for this password first (demo deployments)
DEMO_PASSWORD=""
# Phone numbers (E.164, comma separated) that become ADMIN on first login
ADMIN_PHONES="+8801700000000"
# Document storage: when BLOB_READ_WRITE_TOKEN is set (Vercel Blob), files are stored there
# as private blobs; otherwise on local disk in UPLOAD_DIR.
UPLOAD_DIR="./uploads"
# BLOB_READ_WRITE_TOKEN=""
